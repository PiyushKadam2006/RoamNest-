<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.5rem;
        padding: 1rem 0 0.5rem;
        border-bottom: 1px solid #eee;
        margin-bottom: 1rem;
    }

    .filter {
        text-align: center;
        opacity: 0.6;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .filter:hover {
        opacity: 1;
    }

    .filter i {
        font-size: 1.4rem;
        display: block;
        margin-bottom: 4px;
    }

    .filter p {
        font-size: 0.75rem;
        margin: 0;
        white-space: nowrap;
    }

    .tax-toggle {
        margin-left: auto;
        border: 1px solid #ddd;
        border-radius: 1rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .tax-info {
        display: none;
        color: #888;
    }

    .listing-card {
        border: none !important;
        transition: transform 0.15s ease;
    }

    .listing-card:hover {
        transform: translateY(-3px);
    }
</style>
