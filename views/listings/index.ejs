<div id="filters">
    <% 
    const filters = [
        { label: "Trending",      icon: "fa-fire" },
        { label: "Hotels",        icon: "fa-bed" },
        { label: "Iconic Cities", icon: "fa-mountain-city" },
        { label: "Mountains",     icon: "fa-mountain-sun" },
        { label: "Castles",       icon: "fa-fort-awesome fa-brands" },
        { label: "Amazing Pools", icon: "fa-person-swimming" },
        { label: "Camping",       icon: "fa-campground" },
        { label: "Farms",         icon: "fa-cow" },
        { label: "Arctic",        icon: "fa-snowflake" },
        { label: "Beaches",       icon: "fa-umbrella-beach" },
    ];
    %>
    <% for (let f of filters) { %>
        <a href="/listings?category=<%= f.label %><%= searchTerm ? '&search=' + searchTerm : '' %>" 
           class="filter <%= activeCategory === f.label ? 'active-filter' : '' %>"
           style="text-decoration:none; color:inherit;">
            <div>
                <i class="fa-solid <%= f.icon %>"></i>
                <p><%= f.label %></p>
            </div>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display Total After Taxes</label>
        </div>
    </div>
</div>
<% if (searchTerm || activeCategory) { %>
  <div class="d-flex align-items-center justify-content-between mt-3 mb-1">
    <p class="text-muted mb-0">
      <% if (activeCategory) { %><b><%= activeCategory %></b><% } %>
      <% if (searchTerm) { %> — "<%= searchTerm %>"<% } %>
      &nbsp;· <%= allListing.length %> listing<%= allListing.length !== 1 ? 's' : '' %>
    </p>
    <a href="/listings" class="btn btn-sm btn-outline-secondary">Clear all</a>
  </div>
<% } %>

<% if (allListing.length === 0) { %>
  <div class="text-center mt-5">
    <i class="fa-solid fa-magnifying-glass fa-2x text-muted mb-3 d-block"></i>
    <p class="text-muted">No listings found</p>
    <a href="/listings" class="btn btn-outline-danger">Browse all listings</a>
  </div>
<% } %>
<div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mt-2">
    <% for(let list of allListing){%>
      <a href="/listings/<%= list._id %>" class="listing-link text-decoration-none text-dark">
    <div class="card listing-card">
                <img src="<%=list.image.url%>" class="card-img-top" alt="image-name" style="height: 18rem;">
                <!-- <div class="card-img-overlay">abcd</div> -->
              <div class="card-body px-0 pt-2 pb-0">
    <p class="card-text mb-0">
        <b><%= list.title %></b>
    </p>
    <p class="card-text text-muted" style="font-size:0.9rem;">
        <%= list.location %>, <%= list.country %>
    </p>
    <p class="card-text" style="font-size:0.9rem;">
        <b>&#8377;<%= list.price ? list.price.toLocaleString('en-IN') : 'N/A' %></b> / night
        <i class="tax-info">&nbsp;+18% GST</i>
    </p>
</div>
            </div>
        </a>
        <%}%>



            <!-- </html> -->

            <script>
                let taxSwitch = document.getElementById("switchCheckDefault")
                taxSwitch.addEventListener("click",()=>{
                    // console.log("switch clicked");
                    let taxInfo = document.getElementsByClassName("tax-info");
                    for(info of taxInfo){
                        if(info.style.display != "inline"){
                            info.style.display = "inline";
                        }else{
                            info.style.display = "none";
                        }
                    }
                });
            </script>